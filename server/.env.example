# Endereço público do servidor
PUBLIC_HOST=remote.infradevsolutions.com.br

# DuckDNS (scripts/duckdns.sh): só o nome, sem ".duckdns.org"
DUCKDNS_DOMAIN=remoteinfradev
DUCKDNS_TOKEN=

# Avisos no Telegram (scripts/monitor.sh, duckdns.sh e backup.sh). Deixe vazio para só gravar no log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backup (scripts/backup.sh)
BACKUP_DIR=/home/SEU_USUARIO/backups-infradev-remote
BACKUP_KEEP_DAYS=14
# Cópia para fora do servidor com rclone (ex.: gdrive:infradev-remote). Vazio = só local.
RCLONE_REMOTE=
